{
  "cluster_name": "eks-opentofu-helio",
  "kubernetes_version": "1.33",
  "aws_region": "us-west-2",
  "aws_eks_az1": "us-west-2a",
  "aws_eks_az2": "us-west-2b",
  "root_domain": "aplscicloud.org",
  "auth_subdomain": "oauth-eks-opentofu-helio-us-west-2",
  "daskhub_subdomain": "daskhub-opentofu-us-west-2",
  "cognito_subdomain": "auth-opentofu-us-west-2",
  "cognito_callback_urls": [
    "https://${auth_subdomain}.${var.root_domain}/oauth2/callback"
  ],
  "cognito_logout_urls": [
    "https://${daskhub_subdomain}.${var.root_domain}",
    "https://portal.${var.root_domain}"
  ]
}
