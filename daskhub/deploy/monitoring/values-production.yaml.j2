cost-analyzer:
  ingress:
    enabled: true
{%- if 'monitoring' in config %}
    hosts:
      - {{ config['monitoring']['cost_analyzer_domain_prefix'] }}.{{ config['global']['domain_url'] }}
{%- endif %}
    annotations:
      kubernetes.io/ingress.class: "nginx"
      nginx.ingress.kubernetes.io/auth-url: "https://oauth-{{ config['eksctl']['metadata']['name'] }}-{{ config['eksctl']['metadata']['region'] }}.{{ config['global']['domain_url'] }}/oauth2/auth"
      nginx.ingress.kubernetes.io/auth-signin: "https://oauth-{{ config['eksctl']['metadata']['name'] }}-{{ config['eksctl']['metadata']['region'] }}.{{ config['global']['domain_url'] }}/oauth2/start"
      nginx.ingress.kubernetes.io/proxy-buffer-size: "8k"
      nginx.ingress.kubernetes.io/proxy-buffering: "on"
  grafana:
    grafana.ini:
      server:
{%- if 'monitoring' in config %}
        root_url: https://{{ config['monitoring']['grafana_domain_prefix'] }}.{{ config['global']['domain_url'] }}
{%- endif %}
  extraObjects:
    - apiVersion: networking.k8s.io/v1
      kind: Ingress
      metadata:
        name: grafana-ingress
        namespace: monitoring
        annotations:
          nginx.ingress.kubernetes.io/auth-url: "https://oauth-{{ config['eksctl']['metadata']['name'] }}-{{ config['eksctl']['metadata']['region'] }}.{{ config['global']['domain_url'] }}/oauth2/auth"
          nginx.ingress.kubernetes.io/auth-signin: "https://oauth-{{ config['eksctl']['metadata']['name'] }}-{{ config['eksctl']['metadata']['region'] }}.{{ config['global']['domain_url'] }}/oauth2/start"
          nginx.ingress.kubernetes.io/proxy-buffer-size: "8k"
          nginx.ingress.kubernetes.io/proxy-buffering: "on"
      spec:
        rules:
        {%- if 'monitoring' in config %}
        - host: {{ config['monitoring']['grafana_domain_prefix'] }}.{{ config['global']['domain_url'] }}
        {%- endif %}
          http:
            paths:
            - path: /
              pathType: Prefix
              backend:
                service:
                  name: heliocloud-monitoring-grafana
                  port:
                    number: 80
