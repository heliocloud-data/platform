{
  "cluster_name": "my-silly-cluster-name",
  "kubernetes_version": "1.33",
  "aws_region": "us-west-1",
  "aws_eks_az1": "us-west-1a",
  "aws_eks_az2": "us-west-1b",
  "root_domain": "silly-domain.pizza",
  "auth_subdomain": "oauth",
  "daskhub_subdomain": "daskhub",
  "portal_subdomain": "portal",
  "cognito_subdomain": "auth",
  "cognito_callback_urls": [
    "https://${auth_subdomain}.${var.root_domain}/oauth2/callback"
  ],
  "cognito_logout_urls": [
    "https://${daskhub_subdomain}.${var.root_domain}",
    "https://${portal_subdomain}.${var.root_domain}"
  ]
}
