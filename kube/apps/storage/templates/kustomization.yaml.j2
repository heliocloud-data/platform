# See:
#  https://kubectl.docs.kubernetes.io/references/kustomize/
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
- ../../base/

patches:
- target:
    kind: PersistentVolume
    name: efs-persist
  patch: |
    - op: replace
      path: /spec/capacity/storage
      value: 10Gi
    - op: replace
      path: /spec/nfs/server
      value: {{ tf['outputs']['efs_file_system_id']['value'] }}.efs.{{ tf['outputs']['aws_region']['value'] }}.amazonaws.com
- target:
    kind: PersistentVolumeClaim
    name: efs-persist
  patch: |
    - op: replace
      path: /spec/resources/requests/storage
      value: 10Gi
