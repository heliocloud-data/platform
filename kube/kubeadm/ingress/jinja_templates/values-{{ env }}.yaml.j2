ingress-nginx:
  controller:
    service:
      annotations:
        service.beta.kubernetes.io/aws-load-balancer-type: "nlb"
        service.beta.kubernetes.io/aws-load-balancer-scheme: "internet-facing"
    {%- if 'monitoring' in config %} 
        service.beta.kubernetes.io/aws-load-balancer-ssl-cert: {{ config['global']['domain_certificate_arn'] }}
    {%- endif %}
        service.beta.kubernetes.io/aws-load-balancer-ssl-ports: "https"
        service.beta.kubernetes.io/aws-load-balancer-backend-protocol: "http"
        service.beta.kubernetes.io/aws-load-balancer-attributes: "idle_timeout.timeout_seconds=120"
oauth2-proxy:
  config:
    clientID: "{{ tf['outputs']['cognito_client_id']['value'] }}"
    clientSecret: "{{ tf['outputs']['cognito_client_secret']['value'] }}"
    configFile: |-
      email_domains = [ "*" ]
      upstreams = [ "file:///dev/null" ]
  extraArgs:
    provider: oidc
    oidc-jwks-url: https://cognito-idp.{{ tf['outputs']['aws_region']['value'] }}.amazonaws.com/{{ tf['outputs']['cognito_user_pool_id']['value'] }}/.well-known/jwks.json
    oidc-issuer-url: https://cognito-idp.{{ tf['outputs']['aws_region']['value'] }}.amazonaws.com/{{ tf['outputs']['cognito_user_pool_id']['value'] }}
    redirect-url: https://{{ tf['outputs']['auth_fqdn']['value'] }}/oauth2/callback
    backend-logout-url: https://{{ tf['outputs']['auth_fqdn']['value'] }}/oauth2/sign_out
    whitelist-domain: ".{{ tf['outputs']['root_domain']['value'] }},.amazoncognito.com"
    cookie-domain: .{{ tf['outputs']['root_domain']['value'] }}
    cookie-name: "_oauth2_proxy_{{ tf['outputs']['cognito_user_pool_domain']['value'] }}"
    cookie-secret: {{  tf['outputs']['ingress_cookie_secret']['value'] }}
    cookie-refresh: 30m
    scope: "openid profile email"
    set-authorization-header: true
    set-xauthrequest: true
    pass-user-headers: true
    prefer-email-to-user: false
    pass-authorization-header: true
    skip-auth-strip-headers: false
    pass-access-token: true
    cookie-samesite: "none"
    reverse-proxy: true
    cookie-secure: true
  ingress:
    enabled: true
    hosts:
      - {{ tf['outputs']['auth_fqdn']['value'] }}
    annotations:
      kubernetes.io/ingress.class: "nginx"
      nginx.ingress.kubernetes.io/proxy-buffer-size: "16k"
      nginx.ingress.kubernetes.io/proxy-buffers-number: "8"
