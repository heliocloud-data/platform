daskhub:
  dask-gateway:
    gateway:
      auth:
        jupyterhub:
          apiToken: {{  heritage_params['config']['daskhub']['api_key2'] }}

  jupyterhub:
    ingress:
        enabled: true
        hosts:
          - {{  heritage_params['config']['daskhub']['domain_record'] }}.{{  heritage_params['config']['global']['domain_url'] }}
        annotations:
          kubernetes.io/ingress.class: "nginx"
          nginx.ingress.kubernetes.io/auth-url: "https://oauth-{{ tf['outputs']['eks_cluster_name']['value'] }}-{{ tf['outputs']['aws_region']['value'] }}.{{  heritage_params['config']['global']['domain_url'] }}/oauth2/auth"
          nginx.ingress.kubernetes.io/auth-signin: "https://oauth-{{ tf['outputs']['eks_cluster_name']['value'] }}-{{ tf['outputs']['aws_region']['value'] }}.{{  heritage_params['config']['global']['domain_url'] }}/oauth2/start?rd=https://$host"
          nginx.ingress.kubernetes.io/auth-response-headers: "X-Auth-Request-Access-Token" # headers from cognito
          nginx.ingress.kubernetes.io/proxy-buffer-size: "8k"
          nginx.ingress.kubernetes.io/proxy-buffering: "on"
    hub:
      config:
        Authenticator:
          admin_users: {{  heritage_params['config']['daskhub']['admin_users'] }}
      services:
        dask-gateway:
          apiToken: {{  heritage_params['config']['daskhub']['api_key2'] }}
      extraEnv:
        DASKHUB_URL: "https://{{  heritage_params['config']['daskhub']['domain_record'] }}.{{  heritage_params['config']['global']['domain_url'] }}"
        CLIENT_ID: "{{ tf['outputs']['cognito_client_secret']['value'] }}"
        COGNITO_URL: "https://{{  heritage_params['hc_config']['auth']['domain_prefix'] }}.auth.{{ tf['outputs']['aws_region']['value'] }}.amazoncognito.com/logout"
        OAUTH_LOGOUT_URL: "https://oauth-{{ tf['outputs']['eks_cluster_name']['value'] }}-{{ tf['outputs']['aws_region']['value'] }}.{{  heritage_params['config']['global']['domain_url'] }}/oauth2/sign_out"
