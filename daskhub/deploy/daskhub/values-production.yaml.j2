daskhub:
  dask-gateway:
    gateway:
      auth:
        jupyterhub:
          apiToken: {{ config['daskhub']['api_key2'] }}

  jupyterhub:
    ingress:
        enabled: true
        hosts:
          - {{ config['daskhub']['domain_record'] }}.{{ config['global']['domain_url'] }}
        annotations:
          kubernetes.io/ingress.class: "nginx"
          nginx.ingress.kubernetes.io/auth-url: "https://oauth-{{ config['eksctl']['metadata']['name'] }}-{{ config['eksctl']['metadata']['region'] }}.{{ config['global']['domain_url'] }}/oauth2/auth"
          nginx.ingress.kubernetes.io/auth-signin: "https://oauth-{{ config['eksctl']['metadata']['name'] }}-{{ config['eksctl']['metadata']['region'] }}.{{ config['global']['domain_url'] }}/oauth2/start"
          nginx.ingress.kubernetes.io/auth-response-headers: "X-Auth-Request-User,X-Auth-Request-Email,X-Auth-Request-Preferred-Username" # headers from cognito
          nginx.ingress.kubernetes.io/proxy-buffer-size: "8k"
          nginx.ingress.kubernetes.io/proxy-buffering: "on"
    hub:
      services:
        dask-gateway:
          apiToken: {{ config['daskhub']['api_key2'] }}
